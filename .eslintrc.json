{
  "extends": ["airbnb-base", "prettier"],
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint", "prettier"],
  "rules": {
    "prettier/prettier": ["error", { "semi": true }],
    "eol-last": ["error", "always"],
    "class-methods-use-this": [
      "error",
      {
        "ignoreOverrideMethods": true // Игнорирует все override-методы, включая render
      }
    ],
    "comma-dangle": "off",
    "import/prefer-default-export": "off",
    "max-len": [2, 100],
    "@typescript-eslint/no-unused-vars": 2,
    "max-params": [2, 3],
    "import/extensions": [
      "error",
      "ignorePackages",
      { "js": "never", "ts": "never", "tsx": "never", "jsx": "never" }
    ],
    "no-underscore-dangle": "off",
    "no-param-reassign": ["error", { "props": true, "ignorePropertyModificationsFor": ["target"] }],
    "implicit-arrow-linebreak": "off",
    "function-paren-newline": "off"
  },
  "settings": {
    "import/ignore": ["\\.(scss|css)$", "\\?raw$"],
    "import/resolver": {
      "typescript": {},
      "node": {
        "extensions": [".js", ".ts", ".jsx", ".mjs"]
      }
    }
  },
  "overrides": [
    {
      "files": ["vite.config.*", "scripts/**"],
      "rules": {
        "import/no-extraneous-dependencies": ["error", { "devDependencies": true }]
      }
    }
  ]
}
