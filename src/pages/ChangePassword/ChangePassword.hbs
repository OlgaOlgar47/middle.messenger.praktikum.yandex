<div class="{{styles.formPage}}">
<form class="{{styles.form}}">
  <header class="{{styles.header}}">
    <h1 class="{{styles.title}}">Изменить пароль</h1>
  </header>
  <ul class="{{styles.fields}}">
    <li>
      {{> input
        type="password"
        name="oldPassword"
        label="Старый пароль"
        placeholder="********"
        required=true
        className=styles.input
      }}
    </li>
    <li>
      {{> input
        type="password"
        name="newPassword"
        label="Новый пароль"
        placeholder="********"
        required=true
        className=styles.input
      }}
    </li>
  </ul>

  {{> button type="submit" label="Сохранить изменения" className=styles.button }}
</form>
</div>
