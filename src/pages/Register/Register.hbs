<div class="{{styles.formPage}}">
  <form>
    <header>
      <img src="/images/logoURUS.svg" alt="Логотип" class="{{styles.logo}}" />
      <h1 class="{{styles.title}}">Регистрация</h1>
    </header>
    <ul class="{{styles.fields}}">
      <li>
      {{> input
        type="email"
        name="email"
        placeholder="example@mail.com"
        label="Почта"
        required=true
      }}
      </li>
      <li>
      {{> input
        type="password"
        name="password"
        placeholder="********"
        label="Пароль"
        required=true
        }}
      </li>
      <li>
      {{> input
        type="password"
        name="confirmPassword"
        placeholder="*******"
        label="Повторите пароль"
        required=true
        }}
      </li>
    </ul>
    {{> button type="submit" label="Зарегистрироваться" className=styles.button }}
    {{> link href="#/login" text="Войдите" className=styles.link }}
  </form>
</div>
