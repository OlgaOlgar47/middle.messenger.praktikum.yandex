  <form>
  <header>
    <h1>Регистрация</h1>
  </header>

    <ul>
      <li>
        {{> input type="email" name="email" placeholder="Email" required=true className=styles.input }}
      </li>
      <li>
        {{> input type="password" name="password" placeholder="Пароль" required=true className=styles.input }}
      </li>
      <li>
        {{> input type="password" name="confirmPassword" placeholder="Повторите пароль" required=true className=styles.input }}
      </li>
    </ul>
    {{> button type="submit" label="Зарегистрироваться" className=styles.button }}
    {{> link href="#/login" text="Уже есть аккаунт? Войдите" className=styles.link }}
  </form>