<form class="{{styles.form}}">
  <header class="{{styles.header}}">
    <img src="/images/logoURUS.svg" alt="Логотип" class="{{styles.logo}}" />
    <h1 class="{{styles.title}}">Настройки профиля</h1>
  </header>

  <ul class="{{styles.fields}}">
    <li>
      {{> input
        type="file"
        name="avatar"
        label="Аватар"
        className=styles.input
      }}
    </li>
    <li>
      {{> input
        type="text"
        name="first_name"
        label="Имя"
        placeholder="Иван"
        required=true
        className=styles.input
      }}
    </li>
    <li>
      {{> input
        type="text"
        name="second_name"
        label="Фамилия"
        placeholder="Иванов"
        required=true
        className=styles.input
      }}
    </li>
    <li>
      {{> input
        type="text"
        name="display_name"
        label="Имя в чате"
        placeholder="Иван"
        className=styles.input
      }}
    </li>
    <li>
      {{> input
        type="text"
        name="login"
        label="Логин"
        placeholder="ivanivanov"
        required=true
        className=styles.input
      }}
    </li>
    <li>
      {{> input
        type="email"
        name="email"
        label="Почта"
        placeholder="pochta@yandex.ru"
        required=true
        className=styles.input
      }}
    </li>
    <li>
      {{> input
        type="tel"
        name="phone"
        label="Телефон"
        placeholder="+7 (909) 967 30 30"
        required=true
        className=styles.input
      }}
    </li>

    <hr />

    <li>
      {{> input
        type="password"
        name="oldPassword"
        label="Старый пароль"
        placeholder="********"
        required=true
        className=styles.input
      }}
    </li>
    <li>
      {{> input
        type="password"
        name="newPassword"
        label="Новый пароль"
        placeholder="********"
        required=true
        className=styles.input
      }}
    </li>
  </ul>

  {{> button type="submit" label="Сохранить изменения" className=styles.button }}
  {{> link href="#/logout" text="Выйти из аккаунта" className=styles.link }}
</form>
